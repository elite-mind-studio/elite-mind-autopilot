# Headline Tales (UCGbKmpEbo6pGKxHtMCPPrLA): 2D documentaries about current events.
# Loaded on top of .env by Backend/channel.py; anything not set here comes from .env.
CHANNEL_NAME="Headline Tales"
CHANNEL_ID="UCGbKmpEbo6pGKxHtMCPPrLA"
YOUTUBE_TOKEN_FILE="youtube-oauth2-headline_tales.json"

AUTOPILOT_VOICE="chatterbox:builtin"   # Chatterbox real-human voice (samples 10/11)
CHATTERBOX_FALLBACK_VOICE="kokoro:bm_george"
KOKORO_SPEED="1.0"
STORY_CHARACTER=""
STORY_CHARACTER_LOOK=""
STORY_CHARACTER_LOOK_SHORT=""
SCRIPT_STYLE=""
LONG_SCRIPT_STYLE=""
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
LONG_VISUAL_MODE="ai_images"
VIDEO_LAYOUT="full"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="5"
AUTOPILOT_LONG_SCENE_SECONDS="6"
IMAGE_STYLE="realistic cinematic documentary illustration, grounded and accurate like a news reconstruction, natural lighting, muted colors with deep navy and amber, high detail, sharp"
IMAGE_STYLE_SHORT="realistic cinematic documentary illustration, grounded and accurate like a news reconstruction, natural lighting, muted colors with deep navy and amber, high detail, sharp"
IMAGE_PROMPT_KIND="Realistic documentary illustration of the actual subject, accurate and believable: the real type of aircraft, ship, building or place named in the story, shown as it really looks. Never invent hybrid or impossible objects, never use cartoon symbols (question marks, emojis, speech bubbles, light bulbs), never show text. Never depict real, named people or their faces: show the setting, objects, or anonymous figures from behind instead"
MUSIC_VOLUME="0.04"
YOUTUBE_CATEGORY_ID="25"
YOUTUBE_PLAYLIST="Full Documentaries"
YOUTUBE_PLAYLIST_SHORT="Headline Tales Shorts"
YOUTUBE_DESCRIPTION_FOOTER="Researched from published news reports (sources above). Narration and illustrations are AI-generated. Educational commentary, not breaking news."
YOUTUBE_SYNTHETIC_MEDIA="true"
KAGGLE_IMAGE_KERNEL="headline-imagegen"
# Needed on GitHub too (there is no .env there)
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="kaggle,cloudflare,pollinations"
CLOUDFLARE_STEPS="4"
AUTOPILOT_CAPTION_COLOR="#FFE600"
YOUTUBE_PRIVACY_STATUS="public"
# Owner thumbnails: thumbnails/headline_<date>.png
THUMB_CHANNEL="headline"

# One-tap subscribe link (description + first comment; spoken on long videos)
YOUTUBE_SUBSCRIBE_LINK="https://www.youtube.com/@HeadlineTalesTV?sub_confirmation=1"
