# Headline Tales (UCGbKmpEbo6pGKxHtMCPPrLA): 2D documentaries about current events.
# Loaded on top of .env by Backend/channel.py; anything not set here comes from .env.
CHANNEL_NAME="Headline Tales"
CHANNEL_ID="UCGbKmpEbo6pGKxHtMCPPrLA"
YOUTUBE_TOKEN_FILE="youtube-oauth2-headline_tales.json"

AUTOPILOT_VOICE="chatterbox:george"
CHATTERBOX_FALLBACK_VOICE="kokoro:bm_george"
KOKORO_SPEED="1.0"
STORY_CHARACTER=""
STORY_CHARACTER_LOOK=""
STORY_CHARACTER_LOOK_SHORT=""
SCRIPT_STYLE=""
LONG_SCRIPT_STYLE=""
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
LONG_VISUAL_MODE="ai_images"
VIDEO_LAYOUT="full"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="6"
AUTOPILOT_LONG_SCENE_SECONDS="8"
IMAGE_STYLE="2D documentary editorial illustration, painterly flat shading with subtle texture, muted cinematic colors with deep navy, teal and amber, dramatic lighting, clean composition, high detail, sharp"
IMAGE_STYLE_SHORT="2D documentary editorial illustration, painterly flat shading with subtle texture, muted cinematic colors with deep navy, teal and amber, dramatic lighting, clean composition, high detail, sharp"
IMAGE_PROMPT_KIND="2D documentary illustration. Never depict real, named people or their faces: show symbols instead (oil tankers, warships, maps, flags, ports, fuel pumps, refineries, diplomats seen from behind, generic crowds, newspapers)"
MUSIC_VOLUME="0.10"
YOUTUBE_CATEGORY_ID="25"
YOUTUBE_PLAYLIST="Full Documentaries"
YOUTUBE_PLAYLIST_SHORT="Headline Tales Shorts"
YOUTUBE_DESCRIPTION_FOOTER="Researched from published news reports (sources above). Narration and illustrations are AI-generated. Educational commentary, not breaking news."
YOUTUBE_SYNTHETIC_MEDIA="true"
KAGGLE_IMAGE_KERNEL="headline-imagegen"
# Needed on GitHub too (there is no .env there)
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="kaggle,cloudflare,pollinations"
CLOUDFLARE_STEPS="4"
AUTOPILOT_CAPTION_COLOR="#FFE600"
YOUTUBE_PRIVACY_STATUS="public"
