# Elite Mind Decoder: calm psychology explainers with a soft female voice and a neon wireframe "hologram" look.
# No Black here: a glowing wireframe person, so the channel has more than one visual template.
# Loaded on top of .env by Backend/channel.py; same channel and login as the daily autopilot.
CHANNEL_NAME="Elite Mind Decoder"
CHANNEL_ID="UC6-jC2Uapm8I2PDT2I1nS8A"
YOUTUBE_TOKEN_FILE="youtube-oauth2.json"
THUMB_CHANNEL="elite"

AUTOPILOT_VOICE="chatterbox:builtin"
CHATTERBOX_FALLBACK_VOICE="kokoro:af_heart"
KOKORO_SPEED="1.0"
STORY_CHARACTER=""
STORY_CHARACTER_LOOK=""
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
VIDEO_LAYOUT="full"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="4"
IMAGE_STYLE="glowing neon wireframe hologram style, a human figure made of glowing orange wireframe mesh lines, rooms and objects drawn in glowing blue and purple wireframe on a dark background, digital 3D mesh, cinematic lighting, 9:16 vertical composition"
IMAGE_PROMPT_KIND="Neon wireframe hologram scene with a glowing orange wireframe person"
MUSIC_VOLUME="0.032"
YOUTUBE_CATEGORY_ID="27"
YOUTUBE_PLAYLIST="Psychology Explained"
YOUTUBE_PLAYLIST_SHORT="Psychology Explained"
YOUTUBE_DESCRIPTION_FOOTER="Researched and written by the Elite Mind Decoder team. Produced with AI tools (visuals and narration). Educational content, not medical advice."
YOUTUBE_SYNTHETIC_MEDIA="true"
YOUTUBE_PRIVACY_STATUS="public"
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="cloudflare,kaggle,pollinations"
CLOUDFLARE_STEPS="4"
AUTOPILOT_CAPTION_COLOR="#9DFF3C"

# One-tap subscribe link (description + first comment)
YOUTUBE_SUBSCRIBE_LINK="https://www.youtube.com/@EliteMindDecoder245?sub_confirmation=1"
FIRST_COMMENT_ASK="👇 What do you think? Tell us in the comments, and tell us what we should decode next."
