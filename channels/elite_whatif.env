# Elite Mind Decoder: "What If?" thought experiments told as a story where the viewer is inside it,
# then the real idea is named (who came up with it) and it ends on a "Would you...?" question.
# Black plays "you" in a clean 3D cartoon world with one orange accent, a new look for the channel.
# Loaded on top of .env by Backend/channel.py; same channel and login as the daily autopilot.
CHANNEL_NAME="Elite Mind Decoder"
CHANNEL_ID="UC6-jC2Uapm8I2PDT2I1nS8A"
YOUTUBE_TOKEN_FILE="youtube-oauth2.json"
THUMB_CHANNEL="elite"

AUTOPILOT_VOICE="chatterbox:onyx"
CHATTERBOX_FALLBACK_VOICE="kokoro:am_onyx"
KOKORO_SPEED="1.0"
STORY_CHARACTER="Black"
STORY_CHARACTER_LOOK="a stylized 3D cartoon man with dark brown skin, a round head, short black hair with grey temples, a neat short beard, wearing a black suit, black shirt and a gold wristwatch"
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
VIDEO_LAYOUT="full"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="3"
IMAGE_STYLE="stylized 3D cartoon render, clean simple low-poly shapes, soft studio lighting, muted city colors with one glowing orange accent, cinematic camera angle, high detail, 9:16 vertical composition"
IMAGE_PROMPT_KIND="Stylized 3D cartoon scene with one glowing orange accent"
MUSIC_VOLUME="0.032"
YOUTUBE_CATEGORY_ID="27"
YOUTUBE_PLAYLIST="What If? Thought Experiments"
YOUTUBE_PLAYLIST_SHORT="What If? Thought Experiments"
YOUTUBE_DESCRIPTION_FOOTER="Researched and written by the Elite Mind Decoder team. Black is our original character. Produced with AI tools (visuals and narration)."
YOUTUBE_SYNTHETIC_MEDIA="true"
YOUTUBE_PRIVACY_STATUS="public"
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="cloudflare,kaggle,pollinations"
CLOUDFLARE_STEPS="4"
AUTOPILOT_CAPTION_COLOR="#FF8A1F"

YOUTUBE_SUBSCRIBE_LINK="https://www.youtube.com/@EliteMindDecoder245?sub_confirmation=1"
FIRST_COMMENT_ASK="👇 Be honest: what would YOU do? Tell us in the comments."
