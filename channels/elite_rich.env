# Elite Mind Decoder: "Tricks of the Rich" money explainers: black background, glowing gold and red
# 3D infographic look, big animated dollar cards (GRAPHIC lines), and Black as a faceless glowing figure.
# Loaded on top of .env by Backend/channel.py; same channel and login as the daily autopilot.
CHANNEL_NAME="Elite Mind Decoder"
CHANNEL_ID="UC6-jC2Uapm8I2PDT2I1nS8A"
YOUTUBE_TOKEN_FILE="youtube-oauth2.json"
THUMB_CHANNEL="elite"

AUTOPILOT_VOICE="chatterbox:onyx"
CHATTERBOX_FALLBACK_VOICE="kokoro:am_onyx"
KOKORO_SPEED="1.0"
STORY_CHARACTER="Black"
STORY_CHARACTER_LOOK="a faceless glowing white 3D figure in a black suit with a gold tie and a gold watch"
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
VIDEO_LAYOUT="full"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="2.5"
IMAGE_STYLE="minimal 3D infographic on a pure black background, thin glowing gold and white wireframe lines, glowing gold and red neon labels and icons (money, buildings, documents, charts), dark reflective floor, cinematic, high contrast, 9:16 vertical composition"
IMAGE_PROMPT_KIND="Minimal 3D gold wireframe infographic on black"
MUSIC_VOLUME="0.032"
YOUTUBE_CATEGORY_ID="27"
YOUTUBE_PLAYLIST="Tricks of the Rich"
