YOUTUBE_PRIVACY_STATUS="public"
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="cloudflare,kaggle,pollinations"
CLOUDFLARE_STEPS="4"
