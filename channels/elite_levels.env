# Elite Mind Decoder: "levels" explainers (e.g. 7 levels of manipulation): letterbox layout with a title bar,
# dark minimal flat 2D look, one real study per level, and a protective takeaway at the end.
# Loaded on top of .env by Backend/channel.py; same channel and login as the daily autopilot.
CHANNEL_NAME="Elite Mind Decoder"
CHANNEL_ID="UC6-jC2Uapm8I2PDT2I1nS8A"
YOUTUBE_TOKEN_FILE="youtube-oauth2.json"
THUMB_CHANNEL="elite"

AUTOPILOT_VOICE="chatterbox:onyx"
CHATTERBOX_FALLBACK_VOICE="kokoro:am_onyx"
KOKORO_SPEED="1.0"
STORY_CHARACTER="Black"
STORY_CHARACTER_LOOK="a minimal flat 2D cartoon man with dark brown skin, a round head, a neat short beard, a black suit and a gold wristwatch"
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
VIDEO_LAYOUT="letterbox"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="3"
IMAGE_STYLE="minimalist flat 2D vector animation still, dark moody dusk colors (deep navy, muted purple, warm lamp light), simple shapes, soft spotlight on the characters, lots of empty space, cinematic wide shot, 16:9 composition"
IMAGE_PROMPT_KIND="Minimalist dark flat 2D animation still"
MUSIC_VOLUME="0.032"
YOUTUBE_CATEGORY_ID="27"
YOUTUBE_PLAYLIST="Dark Psychology Decoded"
YOUTUBE_PLAYLIST_SHORT="Dark Psychology Decoded"
YOUTUBE_DESCRIPTION_FOOTER="Researched and written by the Elite Mind Decoder team. Black is our original character. Produced with AI tools (visuals and narration). Made to help you recognize manipulation and protect yourself."
YOUTUBE_SYNTHETIC_MEDIA="true"
YOUTUBE_PRIVACY_STATUS="public"
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="cloudflare,kaggle,pollinations"
CLOUDFLARE_STEPS="4"
AUTOPILOT_CAPTION_COLOR="#FFFFFF"

# One-tap subscribe link (description + first comment)
YOUTUBE_SUBSCRIBE_LINK="https://www.youtube.com/@EliteMindDecoder245?sub_confirmation=1"
FIRST_COMMENT_ASK="👇 Which level have you seen in real life? Tell us in the comments."
