# Elite Mind Decoder: "Test your confidence" quiz Shorts (bright look, A/B/C answers, countdown, reveal).
# Black is "you" in an everyday situation; viewers pick an answer before the timer ends.
# Loaded on top of .env by Backend/channel.py; same channel and login as the daily autopilot.
CHANNEL_NAME="Elite Mind Decoder"
CHANNEL_ID="UC6-jC2Uapm8I2PDT2I1nS8A"
YOUTUBE_TOKEN_FILE="youtube-oauth2.json"
THUMB_CHANNEL="elite"

AUTOPILOT_VOICE="chatterbox:onyx"
CHATTERBOX_FALLBACK_VOICE="kokoro:am_onyx"
KOKORO_SPEED="1.0"
STORY_CHARACTER="Black"
STORY_CHARACTER_LOOK="a simple flat 2D cartoon man with dark brown skin, a round head, short black hair with grey temples, a neat short beard, wearing a black suit, black shirt and a gold wristwatch"
VIDEO_CALL_TO_ACTION=""
VISUAL_MODE="ai_images"
VIDEO_LAYOUT="full"
AI_IMAGES_FALLBACK="none"
IMAGE_SCENE_SECONDS="4"
IMAGE_STYLE="flat 2D vector cartoon illustration, explainer animation style, clean simple shapes, bold dark outlines, bright friendly colors, warm everyday settings (office, party, street), minimal detail, 9:16 vertical composition"
IMAGE_PROMPT_KIND="Flat 2D cartoon illustration, bright everyday scene"
MUSIC_VOLUME="0.032"
YOUTUBE_CATEGORY_ID="27"
YOUTUBE_PLAYLIST="Test Your Confidence"
YOUTUBE_PLAYLIST_SHORT="Test Your Confidence"
YOUTUBE_DESCRIPTION_FOOTER="An original story written by the Elite Mind Decoder team. Black is our original character. Produced with AI tools (visuals and narration)."
YOUTUBE_SYNTHETIC_MEDIA="true"
YOUTUBE_PRIVACY_STATUS="public"
TEXT_PROVIDER="hosted"
TEXT_PROVIDERS="groq,cloudflare,pollinations"
IMAGE_PROVIDERS="cloudflare,kaggle,pollinations"
CLOUDFLARE_STEPS="4"
AUTOPILOT_CAPTION_COLOR="#FFE600"

# One-tap subscribe link (description + first comment)
YOUTUBE_SUBSCRIBE_LINK="https://www.youtube.com/@EliteMindDecoder245?sub_confirmation=1"
